#version 430 core

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba32f, binding = 0) uniform image2D TransmittanceLutImage;
layout(rgba32f, binding = 1) uniform image2D UpperSingleImage;
layout(rgba32f, binding = 2) uniform image2D MultipleScatteringImage;
layout(rgba16f, binding = 3) uniform image2D FinalSkyImage;

layout(binding = 0) uniform sampler2D TransmittanceLut;

uniform int Pass;
layout(std140, binding = 0) uniform SkyParameters {
    vec4 SunDirectionAndRadius;
    vec4 MoonDirectionAndRadius;
    vec4 SunRadianceAndAtmosphereScale;
    vec4 MoonRadianceValue;
    vec4 AtmosphereParameters;
    vec4 LookParameters;
};

#define SunDirection SunDirectionAndRadius.xyz
#define SunAngularRadius SunDirectionAndRadius.w
#define MoonDirection MoonDirectionAndRadius.xyz
#define MoonAngularRadius MoonDirectionAndRadius.w
#define SunRadiance SunRadianceAndAtmosphereScale.xyz
#define AtmosphereScale SunRadianceAndAtmosphereScale.w
#define MoonRadiance MoonRadianceValue.xyz
#define MieScatteringAnisotropy AtmosphereParameters.x
// The direct sunlight times LightManager.SUN_DISC_GAIN.
#define SunDiscRadiance AtmosphereParameters.yzw
#define Saturation LookParameters.x
#define SunsetWarmth LookParameters.y
#define SunGlare LookParameters.z
#define RainbowStrength LookParameters.w

shared vec3 Reduction[64];

const int PASS_BUILD_LUT = 0;
const int PASS_SINGLE_SCATTERING = 1;
const int PASS_REDUCE_AND_COMPOSE = 2;
const int PASS_MULTIPLE_SCATTERING = 3;

#ifndef SKY_WIDTH
#define SKY_WIDTH 64
#endif
#ifndef SKY_HEIGHT
#define SKY_HEIGHT 32
#endif
#ifndef MS_HEIGHTS
#define MS_HEIGHTS 32
#endif
const int UPPER_HEIGHT = SKY_HEIGHT / 2;
const int VIEW_STEPS = 32;
const int LIGHT_STEPS = 40;
const int LUT_WIDTH = 1024;
const int LUT_HEIGHT = 256;

const float PI = 3.14159265358979323846;
const float EARTH_RADIUS = 6371000.0;
const float ATMOSPHERE_RADIUS = 6471000.0;
const float ATMOSPHERE_HEIGHT = ATMOSPHERE_RADIUS - EARTH_RADIUS;
const float RAYLEIGH_HEIGHT = 8000.0;
// Rayleigh scattering at 680, 550 and 440 nm (Hillaire 2020, Bruneton 2017). A blue of
// 22.4e-6, the value at about 480 nm, left the zenith pale.
const vec3 RAYLEIGH_SCATTERING = vec3(5.802e-6, 13.558e-6, 33.1e-6);
// Aerosols of optical depth 0.1 at 550 nm over a 1.2 km scale height, Angstrom exponent
// 1.3, nine tenths of their extinction scattered: an ordinary clear day. They hug the
// ground, so they whiten the horizon's long paths and leave the zenith blue.
const float MIE_HEIGHT = 1200.0;
const vec3 MIE_EXTINCTION = vec3(6.33e-5, 8.33e-5, 11.1e-5);
const vec3 MIE_SCATTERING = MIE_EXTINCTION * 0.9;
// Ozone absorbs green and red in a tent around 25 km. It does little by day but keeps the
// zenith blue while the low sun's light crosses the stratosphere.
const vec3 OZONE_ABSORPTION = vec3(0.650e-6, 1.881e-6, 0.085e-6);
const float OZONE_CENTRE = 25000.0;
const float OZONE_HALF_WIDTH = 15000.0;
// The sun's aureole, a narrow forward lobe over the aerosols' own phase, scaled by the sun
// glare look. Boosting the whole Mie phase tenfold instead filled the zenith, 30 degrees
// from the highest sun, with grey.
const float SUN_HALO_G = 0.96;
const float SUN_HALO_WEIGHT = 0.5;
// The sun disc's light, spread over about a texel either way: the narrower, the brighter
// each glint for the same light.
const float SUN_DISC_SPREAD = radians(0.5);
// A wide, faint skirt around it holding this much light beside the disc's own
// (LightManager.SUN_DISC_SKIRT), so more ripple facets catch a glint and a low sun lays a
// broad, sparkling path on water.
const float SUN_SKIRT_SPREAD = radians(2.5);
const float SUN_SKIRT_SHARE = 0.6;
// Below half float's largest value, which the texture and the runtime's output both use.
const float MAX_SKY_RADIANCE = 60000.0;
// Higher orders of scattering (Hillaire 2020): per height, the light scattered once toward
// it from every direction, the ground's reflection among them, summed as a geometric series.
const int MS_DIRECTIONS = 64;
const int MS_STEPS = 20;
const float GROUND_ALBEDO = 0.3;
const float GROUND_HORIZON_SCALE = 0.9;
const float GROUND_NADIR_SCALE = 0.3;
const vec3 LUMINANCE = vec3(0.2126, 0.7152, 0.0722);
// Roughly luminance-neutral, so warming the horizon recolours it without brightening it.
const vec3 SUNSET_TINT = vec3(1.45, 0.86, 0.5);
// A rainbow's primary bow spans about 40.6 to 42.3 degrees from the anti-solar point, red
// outside; it is drawn a little wider so it reads at this texture's resolution. The
// secondary bow sits at about 50 to 53.5 degrees with its colours reversed.
const float PRIMARY_BOW_INNER = 40.0;
const float PRIMARY_BOW_OUTER = 43.0;
const float SECONDARY_BOW_INNER = 50.0;
const float SECONDARY_BOW_OUTER = 54.0;
const float SECONDARY_BOW_SCALE = 0.35;
const float RAINBOW_SCALE = 1.6;

float raySphere(vec3 origin, vec3 direction, float radius) {
    float b = 2.0 * dot(origin, direction);
    float c = dot(origin, origin) - radius * radius;
    float discriminant = b * b - 4.0 * c;
    if (discriminant < 0.0) {
        return -1.0;
    }
    float root = sqrt(discriminant);
    float nearDistance = (-b - root) * 0.5;
    float farDistance = (-b + root) * 0.5;
    if (farDistance < 0.0) {
        return -1.0;
    }
    return nearDistance < 0.0 ? farDistance : nearDistance;
}

// Distance along a ray to the ground, or -1 when it misses or the ground lies behind.
float rayGround(vec3 origin, vec3 direction) {
    float b = dot(origin, direction);
    float c = dot(origin, origin) - EARTH_RADIUS * EARTH_RADIUS;
    float discriminant = b * b - c;
    if (b >= 0.0 || discriminant < 0.0) {
        return -1.0;
    }
    return -b - sqrt(discriminant);
}

float ozoneDensity(float height) {
    return max(0.0, 1.0 - abs(height - OZONE_CENTRE) / OZONE_HALF_WIDTH);
}

vec3 extinctionAt(float height) {
    return RAYLEIGH_SCATTERING * exp(-height / RAYLEIGH_HEIGHT)
        + MIE_EXTINCTION * exp(-height / MIE_HEIGHT)
        + OZONE_ABSORPTION * ozoneDensity(height);
}

vec3 scatteringAt(float height) {
    return RAYLEIGH_SCATTERING * exp(-height / RAYLEIGH_HEIGHT)
        + MIE_SCATTERING * exp(-height / MIE_HEIGHT);
}

// Where step i of n along a path of the given length begins: the steps lengthen with the
// square, short in the dense air near the start and long where it thins out. Evenly
// spaced, a ray just above the horizon took 70 km steps through the aerosols near the ground.
float stepBoundary(int i, int n, float distance) {
    float t = float(i) / float(n);
    return distance * t * t;
}

// The share of light scattered along a step of this extinction and length that leaves it
// toward its start, per unit of scattering coefficient: closed form, so a long step through
// dense air keeps the light it scatters (Hillaire 2020).
vec3 stepReach(vec3 extinction, float stepSize) {
    return (vec3(1.0) - exp(-extinction * stepSize)) / max(extinction, vec3(1.0e-12));
}

vec3 skyDirection(ivec2 pixel) {
    float u = (float(pixel.x) + 0.5) / float(SKY_WIDTH);
    float v = (float(pixel.y) + 0.5) / float(SKY_HEIGHT);
    float theta = v * PI;
    float phi = u * 2.0 * PI - PI * 0.5;
    float sinTheta = sin(theta);
    return vec3(
        sinTheta * cos(phi),
        cos(theta),
        sinTheta * sin(phi));
}

void buildTransmittanceLut(ivec2 pixel) {
    float normalizedHeight = float(pixel.y) / float(LUT_HEIGHT - 1);
    float radius = EARTH_RADIUS
        + normalizedHeight * normalizedHeight * ATMOSPHERE_HEIGHT;
    float radiusRatio = EARTH_RADIUS / radius;
    float minimumVisibleCos = -sqrt(max(0.0, 1.0 - radiusRatio * radiusRatio));
    float lightCos = 2.0 * float(pixel.x) / float(LUT_WIDTH - 1) - 1.0;
    lightCos = max(lightCos, minimumVisibleCos);
    float lightSin = sqrt(max(0.0, 1.0 - lightCos * lightCos));
    vec3 origin = vec3(0.0, radius, 0.0);
    vec3 direction = vec3(lightSin, lightCos, 0.0);
    float lightDistance = raySphere(origin, direction, ATMOSPHERE_RADIUS);
    vec3 optical = vec3(0.0);
    for (int step = 0; step < LIGHT_STEPS; step++) {
        float start = stepBoundary(step, LIGHT_STEPS, lightDistance);
        float end = stepBoundary(step + 1, LIGHT_STEPS, lightDistance);
        vec3 samplePosition = origin + direction * (0.5 * (start + end));
        float height = max(0.0, length(samplePosition) - EARTH_RADIUS);
        optical += extinctionAt(height) * (end - start);
    }
    imageStore(TransmittanceLutImage, pixel, vec4(exp(-optical), 1.0));
}

bool sampleLight(
    vec3 position,
    float radius,
    vec3 lightDirection,
    out vec3 transmittance) {
    float lightCos = dot(position, lightDirection) / radius;
    if (lightCos < 0.0
        && radius * radius * (1.0 - lightCos * lightCos)
            < EARTH_RADIUS * EARTH_RADIUS) {
        return false;
    }
    float height = max(0.0, radius - EARTH_RADIUS);
    float heightCoordinate = sqrt(min(1.0, height / ATMOSPHERE_HEIGHT))
        * float(LUT_HEIGHT - 1);
    float angleCoordinate = (clamp(lightCos, -1.0, 1.0) + 1.0)
        * 0.5 * float(LUT_WIDTH - 1);
    vec2 uv = (vec2(angleCoordinate, heightCoordinate) + vec2(0.5))
        / vec2(float(LUT_WIDTH), float(LUT_HEIGHT));
    transmittance = texture(TransmittanceLut, uv).rgb;
    return true;
}

// Adds a step's Rayleigh and Mie scattering of a light, given the share of it that reaches the
// viewer (the transmittance to the step times its reach).
void accumulateLight(
    vec3 position,
    float radius,
    vec3 rayleighScattering,
    vec3 mieScattering,
    vec3 reach,
    vec3 lightDirection,
    inout vec3 rayleigh,
    inout vec3 mie) {
    vec3 lightTransmittance;
    if (!sampleLight(position, radius, lightDirection, lightTransmittance)) {
        return;
    }
    vec3 attenuation = reach * lightTransmittance;
    rayleigh += rayleighScattering * attenuation;
    mie += mieScattering * attenuation;
}

float henyeyGreenstein(float cosAngle, float g) {
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * PI * pow(1.0 + g2 - 2.0 * g * cosAngle, 1.5));
}

vec3 finishScattering(
    vec3 viewDirection,
    vec3 lightDirection,
    vec3 lightRadiance,
    vec3 rayleigh,
    vec3 mie,
    float haloWeight) {
    float cosAngle = dot(viewDirection, lightDirection);
    float phaseR = 3.0 / (16.0 * PI) * (1.0 + cosAngle * cosAngle);
    float g2 = MieScatteringAnisotropy * MieScatteringAnisotropy;
    float phaseM = 3.0 / (8.0 * PI)
        * ((1.0 - g2) * (1.0 + cosAngle * cosAngle))
        / ((2.0 + g2)
            * pow(1.0 + g2 - 2.0 * MieScatteringAnisotropy * cosAngle, 1.5));
    phaseM += haloWeight * henyeyGreenstein(cosAngle, SUN_HALO_G);
    return (rayleigh * phaseR + mie * phaseM)
        * lightRadiance * AtmosphereScale;
}

// The multiple-scattering table's heights, spaced by the square like the transmittance table's.
float multipleScatteringHeight(int index) {
    float t = (float(index) + 0.5) / float(MS_HEIGHTS);
    return t * t * ATMOSPHERE_HEIGHT;
}

// Psi for a point at a height and a light (Hillaire 2020): L2, the light scattered once toward
// the point from every direction with an isotropic phase plus the ground's reflection, over
// 1 - f, f the share of light from every direction the atmosphere scatters toward it, which
// sums the orders beyond the second as a geometric series. Per unit of the light's irradiance.
vec3 multipleScattering(float height, vec3 lightDirection) {
    vec3 origin = vec3(0.0, EARTH_RADIUS + height, 0.0);
    vec3 secondOrder = vec3(0.0);
    vec3 transfer = vec3(0.0);
    for (int i = 0; i < MS_DIRECTIONS; i++) {
        // Spread evenly over the sphere on a Fibonacci spiral.
        float z = 1.0 - (2.0 * float(i) + 1.0) / float(MS_DIRECTIONS);
        float phi = float(i) * 2.39996323;
        float r = sqrt(max(0.0, 1.0 - z * z));
        vec3 direction = vec3(r * cos(phi), z, r * sin(phi));
        float groundDistance = rayGround(origin, direction);
        float distance = groundDistance > 0.0
            ? groundDistance
            : raySphere(origin, direction, ATMOSPHERE_RADIUS);
        distance = max(distance, 0.0);
        vec3 transmittance = vec3(1.0);
        vec3 radiance = vec3(0.0);
        vec3 scattered = vec3(0.0);
        for (int s = 0; s < MS_STEPS; s++) {
            float start = stepBoundary(s, MS_STEPS, distance);
            float end = stepBoundary(s + 1, MS_STEPS, distance);
            vec3 position = origin + direction * (0.5 * (start + end));
            float radius = length(position);
            float sampleHeight = max(0.0, radius - EARTH_RADIUS);
            vec3 extinction = extinctionAt(sampleHeight);
            vec3 scattering = scatteringAt(sampleHeight) * transmittance * stepReach(extinction, end - start);
            vec3 lightTransmittance;
            if (sampleLight(position, radius, lightDirection, lightTransmittance)) {
                radiance += scattering * lightTransmittance / (4.0 * PI);
            }
            scattered += scattering;
            transmittance *= exp(-extinction * (end - start));
        }
        if (groundDistance > 0.0) {
            vec3 ground = origin + direction * groundDistance;
            vec3 lightTransmittance;
            if (sampleLight(ground, EARTH_RADIUS, lightDirection, lightTransmittance)) {
                radiance += transmittance * lightTransmittance * GROUND_ALBEDO / PI
                    * max(dot(ground / EARTH_RADIUS, lightDirection), 0.0);
            }
        }
        secondOrder += radiance;
        transfer += scattered;
    }
    secondOrder /= float(MS_DIRECTIONS);
    transfer /= float(MS_DIRECTIONS);
    return secondOrder / max(vec3(1.0) - transfer, vec3(1.0e-3));
}

void generateMultipleScattering(ivec2 pixel) {
    vec3 lightDirection = pixel.y == 0 ? SunDirection : MoonDirection;
    imageStore(
        MultipleScatteringImage,
        pixel,
        vec4(multipleScattering(multipleScatteringHeight(pixel.x), lightDirection), 1.0));
}

// Psi at a height for the sun (row 0) or the moon (row 1), between the table's heights.
vec3 multipleScatteringAt(float height, int row) {
    float position = clamp(sqrt(height / ATMOSPHERE_HEIGHT) * float(MS_HEIGHTS) - 0.5,
        0.0, float(MS_HEIGHTS - 1));
    int low = int(position);
    vec3 below = imageLoad(MultipleScatteringImage, ivec2(low, row)).rgb;
    vec3 above = imageLoad(MultipleScatteringImage, ivec2(min(low + 1, MS_HEIGHTS - 1), row)).rgb;
    return mix(below, above, position - float(low));
}

void generateSingleScattering(ivec2 pixel) {
    vec3 viewDirection = skyDirection(pixel);
    vec3 origin = vec3(0.0, EARTH_RADIUS, 0.0);
    float atmosphereDistance = raySphere(
        origin,
        viewDirection,
        ATMOSPHERE_RADIUS);
    vec3 viewTransmittance = vec3(1.0);
    vec3 sunRayleigh = vec3(0.0);
    vec3 sunMie = vec3(0.0);
    vec3 moonRayleigh = vec3(0.0);
    vec3 moonMie = vec3(0.0);
    vec3 sunMultiple = vec3(0.0);
    vec3 moonMultiple = vec3(0.0);

    for (int step = 0; step < VIEW_STEPS; step++) {
        float start = stepBoundary(step, VIEW_STEPS, atmosphereDistance);
        float end = stepBoundary(step + 1, VIEW_STEPS, atmosphereDistance);
        vec3 samplePosition = origin + viewDirection * (0.5 * (start + end));
        float radius = length(samplePosition);
        float height = max(0.0, radius - EARTH_RADIUS);
        vec3 rayleighScattering = RAYLEIGH_SCATTERING * exp(-height / RAYLEIGH_HEIGHT);
        vec3 mieScattering = MIE_SCATTERING * exp(-height / MIE_HEIGHT);
        vec3 extinction = extinctionAt(height);
        vec3 reach = viewTransmittance * stepReach(extinction, end - start);
        vec3 scattered = (rayleighScattering + mieScattering) * reach;
        sunMultiple += scattered * multipleScatteringAt(height, 0);
        moonMultiple += scattered * multipleScatteringAt(height, 1);
        accumulateLight(samplePosition, radius, rayleighScattering, mieScattering, reach,
            SunDirection, sunRayleigh, sunMie);
        accumulateLight(samplePosition, radius, rayleighScattering, mieScattering, reach,
            MoonDirection, moonRayleigh, moonMie);
        viewTransmittance *= exp(-extinction * (end - start));
    }

    vec3 scattering = finishScattering(
        viewDirection,
        SunDirection,
        SunRadiance,
        sunRayleigh,
        sunMie,
        SUN_HALO_WEIGHT * SunGlare);
    scattering += finishScattering(
        viewDirection,
        MoonDirection,
        MoonRadiance,
        moonRayleigh,
        moonMie,
        0.0);
    scattering += (sunMultiple * SunRadiance + moonMultiple * MoonRadiance) * AtmosphereScale;

    float moonCos = dot(viewDirection, MoonDirection);
    if (acos(clamp(moonCos, -1.0, 1.0)) < MoonAngularRadius) {
        scattering += MoonRadiance * viewTransmittance;
    }

    imageStore(UpperSingleImage, pixel, vec4(scattering, 1.0));
}

// Hue along a bow, 0 on its inner edge (violet) to 1 on its outer edge (red), fading out at both edges.
vec3 bowColour(float t) {
    float hue = (1.0 - t) * 0.75;
    vec3 rgb = clamp(abs(fract(hue + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
    return rgb * smoothstep(0.0, 0.2, t) * smoothstep(1.0, 0.8, t);
}

vec3 rainbow(vec3 viewDirection) {
    if (RainbowStrength <= 0.0 || viewDirection.y <= 0.0) {
        return vec3(0.0);
    }
    float angle = degrees(acos(clamp(dot(viewDirection, -SunDirection), -1.0, 1.0)));
    vec3 colour = bowColour((angle - PRIMARY_BOW_INNER) / (PRIMARY_BOW_OUTER - PRIMARY_BOW_INNER));
    colour += SECONDARY_BOW_SCALE
        * bowColour(1.0 - (angle - SECONDARY_BOW_INNER) / (SECONDARY_BOW_OUTER - SECONDARY_BOW_INNER));
    return colour * smoothstep(0.0, 0.06, viewDirection.y) * RainbowStrength * RAINBOW_SCALE;
}

// The user's look over the physical sky: a warm band toward the sun near the horizon while
// the sun is low, a rainbow lit by the sky behind it, then saturation.
vec3 applyLook(vec3 radiance, vec3 viewDirection) {
    float sunHeight = SunDirection.y;
    float sunset = smoothstep(-0.12, 0.0, sunHeight) * (1.0 - smoothstep(0.05, 0.4, sunHeight));
    float horizon = 1.0 - smoothstep(0.0, 0.45, max(viewDirection.y, 0.0));
    vec2 viewFlat = viewDirection.xz;
    vec2 sunFlat = SunDirection.xz;
    float towardSun = 0.5;
    if (dot(viewFlat, viewFlat) > 1e-6 && dot(sunFlat, sunFlat) > 1e-6) {
        towardSun = 0.5 + 0.5 * max(dot(normalize(viewFlat), normalize(sunFlat)), 0.0);
    }
    float warmth = clamp(SunsetWarmth * sunset * horizon * towardSun, 0.0, 1.0);
    radiance *= mix(vec3(1.0), SUNSET_TINT, warmth);

    float luminance = dot(radiance, LUMINANCE);
    radiance += luminance * rainbow(viewDirection);

    luminance = dot(radiance, LUMINANCE);
    return max(vec3(luminance) + (radiance - vec3(luminance)) * Saturation, vec3(0.0));
}

// The sun disc covers a fraction of a texel, so a test of each texel's centre showed it at
// some sun positions and lost it at others. Its light is spread over the texels around it
// instead, its total kept, and it stays out of the sky's means so it adds no ambient light.
float gaussianSpread(float angle, float spread) {
    return exp(-0.5 * angle * angle / (spread * spread)) / (2.0 * PI * spread * spread);
}

vec3 sunDisc(vec3 viewDirection) {
    float angle = acos(clamp(dot(viewDirection, SunDirection), -1.0, 1.0));
    float discSolidAngle = PI * SunAngularRadius * SunAngularRadius;
    float spread = gaussianSpread(angle, SUN_DISC_SPREAD)
        + SUN_SKIRT_SHARE * gaussianSpread(angle, SUN_SKIRT_SPREAD);
    return SunDiscRadiance * (discSolidAngle * spread);
}

void reduceAndComposeSky() {
    uint invocation = gl_LocalInvocationIndex;
    vec3 finalSum = vec3(0.0);
    for (uint index = invocation;
            index < uint(SKY_WIDTH * UPPER_HEIGHT);
            index += 64u) {
        ivec2 pixel = ivec2(
            int(index) % SKY_WIDTH,
            int(index) / SKY_WIDTH);
        vec3 radiance = applyLook(max(
            imageLoad(UpperSingleImage, pixel).rgb,
            vec3(0.0)), skyDirection(pixel));
        vec2 quantizedRg =
            unpackHalf2x16(packHalf2x16(radiance.rg));
        vec2 quantizedBa =
            unpackHalf2x16(packHalf2x16(vec2(radiance.b, 1.0)));
        finalSum += vec3(quantizedRg, quantizedBa.x);
        imageStore(FinalSkyImage, pixel,
            vec4(min(radiance + sunDisc(skyDirection(pixel)), vec3(MAX_SKY_RADIANCE)), 1.0));
    }
    memoryBarrierImage();
    Reduction[invocation] = finalSum;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (invocation < stride) {
            Reduction[invocation] += Reduction[invocation + stride];
        }
        barrier();
    }
    if (invocation == 0u) {
        imageStore(
            FinalSkyImage,
            ivec2(0, SKY_HEIGHT),
            vec4(
                Reduction[0] / float(SKY_WIDTH * UPPER_HEIGHT),
                1.0));
    }
    barrier();

    for (int x = int(invocation); x < SKY_WIDTH; x += 64) {
        ivec2 horizonPixel = ivec2(x, UPPER_HEIGHT - 1);
        vec3 horizon = applyLook(
            imageLoad(UpperSingleImage, horizonPixel).rgb,
            skyDirection(horizonPixel));
        for (int y = UPPER_HEIGHT; y < SKY_HEIGHT; y++) {
            float amount = float(y - UPPER_HEIGHT)
                / float(SKY_HEIGHT - UPPER_HEIGHT - 1);
            float scale = mix(GROUND_HORIZON_SCALE, GROUND_NADIR_SCALE, amount);
            imageStore(
                FinalSkyImage,
                ivec2(x, y),
                vec4(max(horizon * scale, vec3(0.0)), 1.0));
        }
    }
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (Pass == PASS_BUILD_LUT) {
        if (pixel.x < LUT_WIDTH && pixel.y < LUT_HEIGHT) {
            buildTransmittanceLut(pixel);
        }
    } else if (Pass == PASS_SINGLE_SCATTERING) {
        if (pixel.x < SKY_WIDTH && pixel.y < UPPER_HEIGHT) {
            generateSingleScattering(pixel);
        }
    } else if (Pass == PASS_REDUCE_AND_COMPOSE) {
        reduceAndComposeSky();
    } else if (Pass == PASS_MULTIPLE_SCATTERING) {
        if (pixel.x < MS_HEIGHTS && pixel.y < 2) {
            generateMultipleScattering(pixel);
        }
    }
}
