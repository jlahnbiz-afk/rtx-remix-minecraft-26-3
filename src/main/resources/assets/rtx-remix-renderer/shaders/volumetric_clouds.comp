#version 430 core

// Volumetric clouds for the Unbound style, ray marched into a panorama of the upper sky
// that is drawn over the dome. The layering follows how Bliss builds its skies: small and
// large cumulus and an altostratus sheet, each covered by flat noise, grown taller where the
// cover is strong and eroded by sheared 3D detail, with the layers above shading the ones
// below. The noise is the Perlin-Worley set of Schneider's "The Real-time Volumetric
// Cloudscapes of Horizon Zero Dawn" (SIGGRAPH 2015), and light is integrated with
// Hillaire's energy-conserving step ("Physically Based Sky, Atmosphere and Cloud Rendering
// in Frostbite", SIGGRAPH 2016).

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba8, binding = 0) uniform image3D NoiseImage;
layout(rgba16f, binding = 1) uniform image2D HistoryImage;
layout(rgba16f, binding = 2) uniform image2D OutputImage;

uniform sampler3D Noise;
// The high cirrus layer's density in the sky layers' polar layout; see SkyLayerTextures.cirrus.
uniform sampler2D Cirrus;
uniform int Pass;

layout(std140, binding = 1) uniform CloudParameters {
    vec4 CameraAndFrame;
    vec4 LightDirectionValue;
    vec4 LightIrradianceValue;
    vec4 AmbientTopAndSmallCoverage;
    vec4 AmbientBottomAndDensity;
    vec4 LayerParameters;
    vec4 OutputParameters;
    vec4 LookParameters;
};

#define CameraXZ CameraAndFrame.xy
#define CameraHeight CameraAndFrame.z
#define FrameIndex CameraAndFrame.w
#define LightDirection LightDirectionValue.xyz
#define LightIrradiance LightIrradianceValue.rgb
#define AmbientTop AmbientTopAndSmallCoverage.rgb
#define LayerCoverage vec3(AmbientTopAndSmallCoverage.w, OutputParameters.x, LookParameters.w)
#define AmbientBottom AmbientBottomAndDensity.rgb
#define Density AmbientBottomAndDensity.w
#define CloudBase LayerParameters.x
#define CloudThickness LayerParameters.y
#define FeatureScale LayerParameters.z
#define HistoryWeight LayerParameters.w
#define Parity OutputParameters.y
#define HazeDistance OutputParameters.z
#define Brightness OutputParameters.w
#define Detail LookParameters.x
#define CirrusAngle LookParameters.y
#define CirrusStrength LookParameters.z

#ifndef CLOUD_WIDTH
#define CLOUD_WIDTH 64
#endif
#ifndef CLOUD_HEIGHT
#define CLOUD_HEIGHT 16
#endif
#ifndef CLOUD_UPPER_ROWS
#define CLOUD_UPPER_ROWS 12
#endif
#ifndef MIN_ELEVATION_DEGREES
#define MIN_ELEVATION_DEGREES -4.0
#endif
#ifndef CIRRUS_MIN_ELEVATION_DEGREES
#define CIRRUS_MIN_ELEVATION_DEGREES 3.0
#endif

const int PASS_NOISE = 0;
const int PASS_MARCH = 1;
const int NOISE_SIZE = 128;

const float PI = 3.14159265358979323846;
uvec3 pcg3d(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return v;
}

// A random point in [0, 1)^3 for a lattice cell, wrapping every period cells so the noise tiles.
vec3 cellHash(ivec3 cell, int period, uint seed) {
    // Cells reach one below zero, and GLSL leaves the remainder of a negative operand undefined.
    uvec3 wrapped = uvec3((cell + ivec3(period)) % period);
    return vec3(pcg3d(wrapped + uvec3(seed * 1031u, seed * 2053u, seed * 4099u))) * (1.0 / 4294967296.0);
}

float gradientNoise(vec3 p, int period, uint seed) {
    ivec3 cell = ivec3(floor(p));
    vec3 f = fract(p);
    vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float corners[8];
    for (int i = 0; i < 8; i++) {
        ivec3 offset = ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        vec3 gradient = normalize(cellHash(cell + offset, period, seed) * 2.0 - 1.0);
        corners[i] = dot(gradient, f - vec3(offset));
    }
    float x00 = mix(corners[0], corners[1], u.x);
    float x10 = mix(corners[2], corners[3], u.x);
    float x01 = mix(corners[4], corners[5], u.x);
    float x11 = mix(corners[6], corners[7], u.x);
    return mix(mix(x00, x10, u.y), mix(x01, x11, u.y), u.z);
}

float worley(vec3 p, int period, uint seed) {
    ivec3 cell = ivec3(floor(p));
    vec3 f = fract(p);
    float nearest = 1.0e9;
    for (int z = -1; z <= 1; z++) {
        for (int y = -1; y <= 1; y++) {
            for (int x = -1; x <= 1; x++) {
                ivec3 offset = ivec3(x, y, z);
                vec3 feature = vec3(offset) + cellHash(cell + offset, period, seed);
                vec3 delta = f - feature;
                nearest = min(nearest, dot(delta, delta));
            }
        }
    }
    return 1.0 - clamp(sqrt(nearest), 0.0, 1.0);
}

float worleyFbm(vec3 uvw, int cells, uint seed) {
    return worley(uvw * float(cells), cells, seed) * 0.625
        + worley(uvw * float(cells * 2), cells * 2, seed + 1u) * 0.25
        + worley(uvw * float(cells * 4), cells * 4, seed + 2u) * 0.125;
}

float perlinFbm(vec3 uvw, int cells, uint seed) {
    float sum = 0.0;
    float amplitude = 0.5;
    for (int octave = 0; octave < 4; octave++) {
        int octaveCells = cells << octave;
        sum += amplitude * gradientNoise(uvw * float(octaveCells), octaveCells, seed + uint(octave));
        amplitude *= 0.5;
    }
    return clamp(sum + 0.5, 0.0, 1.0);
}

// R: Perlin-Worley base shape. G, B, A: Worley fractals of rising frequency.
void buildNoise(ivec3 texel) {
    if (any(greaterThanEqual(texel, ivec3(NOISE_SIZE)))) {
        return;
    }
    vec3 uvw = (vec3(texel) + 0.5) / float(NOISE_SIZE);
    float perlin = perlinFbm(uvw, 4, 1u);
    float cells = worleyFbm(uvw, 4, 11u);
    float perlinWorley = cells + perlin * (1.0 - cells);
    imageStore(NoiseImage, texel, vec4(
        perlinWorley,
        worleyFbm(uvw, 8, 21u),
        worleyFbm(uvw, 16, 31u),
        worleyFbm(uvw, 32, 41u)));
}

#include "cloud_field.glsl"

// The upper rows run linearly from the zenith down to MIN_ELEVATION_DEGREES; the few rows
// below them carry the rest of the way to the nadir, for clouds seen from above beyond the
// land, fine beside the horizon and coarse toward the nadir; see
// VolumetricCloudGenerator.elevationDegrees.
vec3 panoramaDirection(ivec2 pixel) {
    float u = (float(pixel.x) + 0.5) / float(CLOUD_WIDTH);
    float lower = (float(pixel.y - CLOUD_UPPER_ROWS) + 0.5) / float(CLOUD_HEIGHT - CLOUD_UPPER_ROWS);
    float elevationDegrees = pixel.y < CLOUD_UPPER_ROWS
        ? mix(90.0, MIN_ELEVATION_DEGREES, (float(pixel.y) + 0.5) / float(CLOUD_UPPER_ROWS))
        : mix(MIN_ELEVATION_DEGREES, -90.0, lower * lower);
    float elevation = radians(elevationDegrees);
    float azimuth = u * 2.0 * PI;
    float horizontal = cos(elevation);
    return vec3(horizontal * sin(azimuth), sin(elevation), -horizontal * cos(azimuth));
}

// Premultiplied radiance and opacity of the clouds along one direction, nearest layer first.
vec4 marchClouds(vec3 direction, ivec2 pixel) {
    // White noise per texel and dispatch: a spatial pattern that every dispatch shares
    // survives the running average and shows as a fine grid where the panorama is magnified.
    float jitter = float(pcg3d(uvec3(pixel, uint(FrameIndex))).x) * (1.0 / 4294967296.0);
    float entry;
    return marchCloudsTo(direction, jitter, MAX_DISTANCE, entry);
}

void main() {
    if (Pass == PASS_NOISE) {
        buildNoise(ivec3(gl_GlobalInvocationID));
        return;
    }
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.y == CLOUD_HEIGHT) {
        // The row below the panorama carries the clouds' extinction per block where the camera
        // stands, so the world can fog over while the camera is inside a cloud.
        if (pixel.x == 0) {
            vec3 camera = vec3(CameraXZ.x, CameraHeight, CameraXZ.y);
            float extinction = 0.0;
            for (int layer = 0; layer < 3; layer++) {
                extinction += layerDensity(layer, camera, true) * EXTINCTION;
            }
            for (int shape = 0; shape < CLOUD_MAX_SHAPES; shape++) {
                if (shape >= ShapeCount) {
                    break;
                }
                extinction += shapeDensity(shape, camera, true) * EXTINCTION;
            }
            imageStore(OutputImage, pixel, vec4(extinction, 0.0, 0.0, 1.0));
        }
        return;
    }
    if (pixel.x >= CLOUD_WIDTH || pixel.y >= CLOUD_HEIGHT) {
        return;
    }
    vec4 history = imageLoad(HistoryImage, pixel);
    // Half the texels refresh per dispatch, alternating, and fold into a running average
    // that smooths the jittered march; a weight of one restarts every texel.
    if (HistoryWeight >= 1.0 || ((pixel.x + pixel.y) & 1) == int(Parity)) {
        vec3 direction = panoramaDirection(pixel);
        vec4 current = marchClouds(direction, pixel);
        // The cirrus lies far above, so it shows only through what the clouds let pass.
        current += (1.0 - current.a) * cirrusLayer(direction);
        history = mix(history, current, HistoryWeight);
        imageStore(HistoryImage, pixel, history);
    }
    imageStore(OutputImage, pixel, vec4(max(history.rgb, vec3(0.0)), clamp(history.a, 0.0, 1.0)));
}
